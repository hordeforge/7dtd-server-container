# Template for the git-ignored .env read by scripts/run.sh and scripts/perf.sh
# in this directory. Values already present in the environment win over the
# file; commented-out lines are simply absent, which is the shipped default.
# Copy to .env, fill in, and never commit .env itself.

# Telnet console password. The unset default is the public lab value, and a
# set password makes the game listen for telnet on every interface, so set a
# private one. Must avoid \ | & ' " $ ` < > and control characters.
TELNET_PASSWORD=change-me

# Telnet console port, 1..65535. Default 8087.
TELNET_PORT=8087

# Dashboard webuser password, at least 8 characters, same character rules as
# the telnet password. Leave this unset (the default): the entrypoint then
# mints a random password at first seed and records it once in the owner-only
# file data/userdata/Saves/.webadmin-password. A value here applies only to
# the seed: once Saves/serveradmin.xml exists, delete it to re-seed.
#WEBADMIN_PASSWORD=change-me

# Depot handling, both 0 or 1. STEAMCMD_UPDATE=0 skips the per-boot steamcmd
# validate (offline or fast restarts); STEAMCMD_ONLY=1 installs and exits
# without booting the game (what `run.sh install-only` forces anyway).
STEAMCMD_UPDATE=1
STEAMCMD_ONLY=0

# Container name and image tag used by scripts/run.sh and the quadlet unit.
SEVENDTD_CONTAINER_NAME=7dtd-server
SEVENDTD_IMAGE=localhost/7dtd-server:latest
