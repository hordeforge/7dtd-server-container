# 7dtd-server quadlet for rootless podman as a systemd user service.
# This is the durable path (survives logout/reboot); scripts/run.sh is the
# ad-hoc path for build/verify.
#
#   podman build -t localhost/7dtd-server:latest .
#   cp systemd/7dtd-server.container ~/.config/containers/systemd/
#   systemctl --user daemon-reload
#   systemctl --user enable --now 7dtd-server
#   loginctl enable-linger maci          # keep the service after logout
[Unit]
Description=7 Days to Die dedicated server (Navezgane, EfficientServer + APM bridge)
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/7dtd-server:latest
# The image is built on this host (`podman build -t localhost/7dtd-server
# ... .`) and is never published to a registry, so there is nothing to pull
# from. Quadlet otherwise defaults to Pull=missing, which only stays quiet
# while the image is present locally: after a `podman rmi` or a prune the
# unit would try to pull localhost/7dtd-server from a registry that does not
# exist on this host and fail at boot. never makes the missing image an
# honest "build it first" error instead of a pull attempt.
Pull=never
ContainerName=7dtd-server
Network=host
# catatonit takes PID 1 and reaps orphans/zombies for the game's whole
# uptime; without it, children the server forks but never waits on accumulate
# as zombies until the container restarts (same rationale as start() in
# scripts/run.sh).
Init=true
# TELNET_PASSWORD/TELNET_PORT are deliberately not pinned here: the entrypoint
# sources scripts/lib-env.sh (baked into the image) whose init_telnet_env owns
# the lab defaults and validation for both lifecycles, so this unit cannot
# drift from them. To override, set Environment= lines here AND keep the same
# values in .env / the environment used by scripts/run.sh, or the graceful
# stop below will fail its telnet login and fall back to a forced stop.
# Environment=TELNET_PASSWORD=change-me
# Environment=TELNET_PORT=8087
# With no TELNET_PASSWORD here the entrypoint refuses to boot, because the
# committed default is public and a set telnet password makes the game listen
# on every interface. Uncomment only to run the lab on that default.
# Environment=ALLOW_PUBLIC_DEFAULT_TELNET_PASSWORD=1
# Dashboard webuser password; when unset the entrypoint mints a random one at
# first seed and records it in the owner-only file
# data/userdata/Saves/.webadmin-password. Set a value here to control it:
# Environment=WEBADMIN_PASSWORD=change-me
# :Z relabels the sources to container_file_t (SELinux enforcing RHEL host).
# mods is rw for the /api/perf toggle (EfficientServer config).
# The game binary and steamcmd run as container root by design (see the
# Containerfile), but nothing in this image needs a setuid escalation, so
# no-new-privileges blocks one if the game or a mod ever turns hostile.
PodmanArgs=--security-opt=no-new-privileges
Volume=%h/7dtd-server/data/game:/root/7dtd:Z
Volume=%h/7dtd-server/data/userdata:/root/.local/share/7DaysToDie:Z
Volume=%h/7dtd-server/mods:/mods:Z
Volume=%h/7dtd-server/config:/config:ro,Z
# Liveness for a server process that is up but no longer serving (a wedged
# world load leaves the container running). Same command scripts/run.sh start
# passes to podman: the probe sources the lib the image ships, so it checks
# the port init_telnet_env owns above instead of a second hardcoded number,
# and it never sends the password. The start period covers a first boot, where
# steamcmd installs a multi-GB depot before the game opens the port. A health
# status is reported in `systemctl --user status`; it never restarts or kills
# the container, so a red status cannot take the server down.
HealthCmd=bash -c 'source /usr/local/lib/7dtd-lib-env.sh && health_check'
HealthInterval=60s
HealthRetries=3
HealthStartPeriod=30m

[Service]
Restart=always
# The dedicated server ignores SIGTERM (observed: no save, hung until the
# stop timeout), so the default signal-based container stop kills it with no
# world save. Route every systemd-driven stop/restart/shutdown through the
# same graceful path the ad-hoc lifecycle uses: telnet save+shutdown, a
# bounded wait, then a forced-stop fallback (scripts/run.sh stop).
# TimeoutStopSec must cover the worst case: telnet probe 3s + session 10s +
# podman wait 90s + podman stop 30s.
ExecStop=%h/7dtd-server/scripts/run.sh stop
TimeoutStopSec=180

[Install]
WantedBy=default.target
