# Runtime data on the server host (game files, saves, logs). Never commit.
data/
# Staged mod builds, regenerable via scripts/stage_mods.sh from sibling dist/.
mods-available/
mods/
# Local secrets / env overrides (TELNET_PASSWORD etc).
.env
coverage/
coverage.cobertura.xml
# Python bytecode from importing coverage_badge in its unit tests.
scripts/__pycache__/

# Local scratch space (never commit).
.scratch/
